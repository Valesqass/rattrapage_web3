# Copier en .env et remplacer chaque valeur avant tout deploiement reel.
MQTT_ADMIN_PASSWORD=
MQTT_FRONT_PASSWORD=
MQTT_GW_PASSWORD=
# Secret maitre de provisionnement : mot de passe node = sha256("$MQTT_NODE_SECRET:<id>")[0:24]
MQTT_NODE_SECRET=

# Simulation
SIM_SCENARIO=incidents
SIM_SPEED=60
SIM_SEED=42
